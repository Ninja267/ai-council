# AI Council - API keys
# Copy this file to .env and fill in your real keys.
# NEVER commit your real .env to git.

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT) - https://platform.openai.com/
OPENAI_API_KEY=

# Google Gemini - https://aistudio.google.com/
GOOGLE_API_KEY=

# xAI (Grok) - https://console.x.ai/
XAI_API_KEY=

# --- Optional model overrides ---
# Defaults reflect current top models; change if you want cheaper/faster ones.
CLAUDE_MODEL=claude-opus-4-5
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash
GROK_MODEL=grok-4-1-fast-reasoning

# --- Server ---
PORT=3000
# Cap the user question length to mitigate abuse.
MAX_QUESTION_CHARS=2000

# --- Access gate (recommended for any public deployment) ---
# When set, every /api/* request must include header `X-Access-Password`
# matching this value. The frontend prompts users for it on first visit
# and remembers it in localStorage. Leave empty for fully open access
# (only suitable for purely-local use).
ACCESS_PASSWORD=
